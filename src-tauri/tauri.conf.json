{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileView",
  "version": "0.2.0",
  "identifier": "com.fileview.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileView",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Notepad++ 风格的多格式文件查看与编辑器",
    "longDescription": "A Windows 11 Fluent style Notepad++-like viewer and editor for JSON, Markdown, YAML, TOML, CSV, XML, HTML, code and text files with shell integration.",
    "category": "DeveloperTool",
    "publisher": "FileView Team",
    "copyright": "© 2025 FileView Team",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
